# Every variable is optional. With none set, guests still get the flight and
# their pass; leads are only logged to the dev console.

# Webhook: POST each lead as JSON (Zapier, Make, n8n, your API)
LEAD_WEBHOOK_URL=
# Signs the body: x-flight-pass-signature: sha256=<hex HMAC>
LEAD_WEBHOOK_SECRET=

# Supabase: run supabase/schema.sql first. Server-only key, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Customer.io Track API: identify + a "flight_boarded" event
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
# us (default) or eu
CUSTOMERIO_REGION=us

# Resend: a "new passenger" email to you, and optionally the pass to the guest
RESEND_API_KEY=
RESEND_FROM="Your Spacelines <flights@example.com>"
RESEND_NOTIFY_TO=
RESEND_SEND_CONFIRMATION=false

# Shared rate limit across server instances (else in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
